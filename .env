# ==============================================================================
# STACHOLSKI DIGITAL SOLUTIONS - ZERO-TRUST PLATFORM CONFIGURATION
# ==============================================================================

# CONFIGURAÇÕES DO DOCKER ECOSYSTEM
COMPOSE_PROJECT_NAME=defesa-ativa-xdr

# CONFIGURAÇÕES DE SEGURANÇA (ZERO-TRUST)
SOC_SECURITY_TOKEN=zt-token-secreto-2026
SOC_TOKEN_HEADER=X-SOC-Token

# PORTAS INFRAESTRUTURA (HOST:CONTAINER)
PORT_JAVA_BACKEND=8080
PORT_MQTT_BROKER=1883
PORT_PROMETHEUS=9090
PORT_GRAFANA=3000

# CONFIGURAÇÕES DO BANCO DE DADOS
SPRING_DB_URL=jdbc:h2:file:./data/soc_db
SPRING_DB_USER=admin
SPRING_DB_PASSWORD=admin

# CONFIGURAÇÕES DE AUTOMAÇÃO GIT
GIT_REMOTE_ORIGIN=origin
GIT_TARGET_BRANCH=main